modules = ["python-base-3.13"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -c \"from http.server import SimpleHTTPRequestHandler,ThreadingHTTPServer; import os; os.chdir('public'); H=type('H',(SimpleHTTPRequestHandler,),{'do_GET':lambda s: (setattr(s,'path','/login.html'),SimpleHTTPRequestHandler.do_GET(s)) if s.path=='/' else SimpleHTTPRequestHandler.do_GET(s)}); ThreadingHTTPServer(('0.0.0.0',5000),H).serve_forever()\""
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
